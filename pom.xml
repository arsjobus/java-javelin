<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javelin</groupId>
    <artifactId>javelin-ide</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Javelin IDE</name>
    <description>A local-first, human-directed Java code editor.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25.0.2</javafx.version>
        <junit.version>5.11.4</junit.version>
        <archunit.version>1.4.1</archunit.version>
        <slf4j.version>2.0.17</slf4j.version>
        <!-- Filled in by the JaCoCo agent when it runs; empty otherwise so surefire's @{argLine} always resolves. -->
        <argLine></argLine>
        <!--
            Tests tagged "eval" talk to a real model and take minutes, so `mvn test` leaves them out. `mvn -Peval test
            -Deval.model=...` runs only them. See docs/eval/README.md.
        -->
        <test.groups></test.groups>
        <test.excludedGroups>eval</test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.7</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Test only: ArchitectureTest turns the package rules in ARCHITECTURE.md into failing tests. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Test only: ArchUnit logs through SLF4J, which prints "No SLF4J providers were found" without one. NOP keeps the build output quiet and adds no logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar keeps the product spelling (Javelin, capital J); packaging/macos/build-app.sh picks it up by this name. -->
        <finalName>Javelin-IDE-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <!--
                        JavaFX is only supported as named modules; on the class path it prints "Unsupported JavaFX
                        configuration". So the test JVM gets the JavaFX platform jars on a module path (copied to
                        target/test-fx below) and Surefire keeps them off the class path. Native access goes to
                        javafx.graphics by name, as in the app.
                    -->
                    <argLine>@{argLine} -Dfile.encoding=UTF-8 --module-path ${project.build.directory}/test-fx --add-modules javafx.controls --enable-native-access=javafx.graphics</argLine>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.openjfx:javafx-base</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-graphics</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-controls</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    Test JVM only: copies the JavaFX platform jars (the ones with a classifier; the class-less stubs of the
                    same module name are left out) to target/test-fx for Surefire's module path. Only the classifier that
                    matches this machine is in the dependency tree, so listing them all is safe.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-javafx-for-tests</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/test-fx</outputDirectory>
                            <includeGroupIds>org.openjfx</includeGroupIds>
                            <includeClassifiers>linux,linux-aarch64,mac,mac-aarch64,win</includeClassifiers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.28.0</version>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Coverage gate. The JavaFX user interface (App, ui/*) needs a display and is verified by hand and by
                    the smoke checks in HARDENING.md, so it is excluded. The remaining code must stay above 95% line
                    coverage and 85% branch coverage. `mvn verify` fails if either slips, and the HTML report lands in
                    target/site/jacoco.
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <configuration>
                    <excludes>
                        <exclude>com/javelin/App*</exclude>
                        <exclude>com/javelin/Launcher*</exclude>
                        <exclude>com/javelin/ui/**</exclude>
                        <!-- Asks the JDK to use the operating system's trash; needs a desktop session. Everything around it is covered. -->
                        <exclude>com/javelin/io/DesktopTrash*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.javelin.App</mainClass>
                    <options>
                        <!-- JavaFX loads its native libraries through a restricted method. Grant that to JavaFX only, so the JDK stays quiet and blocks every other module that tries. -->
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- The live AI edit measurement (docs/eval/README.md): only the tests tagged "eval", against a real model. -->
            <id>eval</id>
            <properties>
                <test.groups>eval</test.groups>
                <test.excludedGroups>not-a-tag</test.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
