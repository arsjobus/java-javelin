+  @Test
+  void theSameBlockWrittenTwiceIsMadeOnce() throws Exception {
+    String block = reply("    int twice(int a) {", "    int twice(int a) {\n        // doubles");
+    assertEquals(
+        CODE.replace("    int twice(int a) {", "    int twice(int a) {\n        // doubles"),
